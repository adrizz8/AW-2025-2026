<a href="/" class="md-back-button">
  <span class="md-back-icon">←</span>
  <span class="md-back-label">Volver al inicio</span>
</a>
<div class="login-container">
  <div class="login-formulario">
    <h1>¡Bienvenido!</h1>
    <form action="/login" method="POST" id="form-login">
      <span id="email-error-login" class="mensaje-error <%= errorLogin ? 'activo' : '' %>">
        <%= errorLogin || '' %>
      </span>
      <input type="email" id="email-login" name="email" placeholder="Correo corporativo" required>
      <input type="password" id="password-login" name="contraseña" placeholder="Contraseña" required>
      <label class="recordar-sesion">
        <input type="checkbox" name="recordar">
        <span>Recordar sesión</span>
      </label>
      <button type="submit">Entrar</button>
    </form>
    <p>¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
  </div>
  <div class="imagen-sesion">
    <img src="/images/login.png" alt="Imagen login">
  </div>
</div>
<script src="/js/comprobacion_forms.js"></script>