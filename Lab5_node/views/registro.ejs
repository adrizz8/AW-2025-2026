<a href="/" class="md-back-button">
  <span class="md-back-icon">←</span>
  <span class="md-back-label">Volver al inicio</span>
</a>

<div class="registro-container">
  <div class="registro-formulario">
    <h1>Registra un nuevo empleado</h1>
    <h2>Introduce los siguientes datos para crear una nueva cuenta de empleado:</h2>
    
    <% if (error) { %>
      <div class="mensaje-error-general"><%= error %></div>
    <% } %>
    
    <form action="/registro" method="POST" id="form-registro">
      <input type="text" name="nombre" placeholder="Nombre completo" required>
      
      <span id="email-error-registro" class="mensaje-error"></span>
      <input type="email" id="email-registro" name="email" placeholder="Correo corporativo (usuario@moveit.es)" required>
      
      <span id="password-error-registro" class="mensaje-error"></span>
      <input type="password" id="password-registro" name="contraseña" placeholder="Contraseña" required>
      
      <input type="tel" name="telefono" placeholder="Número de teléfono" required>

        <select name="rol" id="rol" required>
        <option value="" disabled selected>Selecciona un rol</option>
        <option value="empleado">Empleado</option>
        <option value="admin">Administrador</option>
      </select>
      
      <select aria-label="Concesionarios" id="concesionarios" name="concesionarios" required>
        <option value="" disabled selected>Selecciona un concesionario</option>
        <% if (concesionarios && concesionarios.length > 0) { %>
          <optgroup label="Concesionarios disponibles">
            <% concesionarios.forEach(function(concesionario) { %>
              <option value="<%= concesionario.id_concesionario %>"><%= concesionario.nombre %></option>
            <% }); %>
          </optgroup>
        <% } else { %>
          <option value="" disabled>No hay concesionarios disponibles</option>
        <% } %>
      </select>
      
      <button type="submit">Registrar</button>
    </form>
  </div>
  
  <div class="imagen-sesion">
    <img src="/images/login.png" alt="Imagen login">
  </div>
</div>

<script src="/js/comprobacion_forms.js"></script>