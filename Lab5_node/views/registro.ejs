
  <h1>Registro de Usuario</h1>
  <form action="/registro" method="POST"> <input type="text" name="nombre" placeholder="Nombre" required><br> <input
      type="email" name="email" placeholder="Correo electrónico" required><br> <input type="password" name="contraseña" placeholder="Contraseña" 
       required minlength="8" title="La contraseña debe tener al menos 8 caracteres">
<br> <button type="submit">Registrarse</button> </form>
  <p>¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>