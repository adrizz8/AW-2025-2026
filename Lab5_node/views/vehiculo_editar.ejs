<h1>Editar Vehículo</h1>
<% if (errores && errores.length > 0) { %>
  <ul style="color: red; font-weight:bold;">
    <% errores.forEach(e => { %>
      <li><%= e %></li>
    <% }) %>
  </ul>
<% } %>
<form action="/vehiculos/<%= vehiculo.id_vehiculo %>/editar" method="POST">
  <label>Matrícula:</label>
  <input type="text" name="matricula" value="<%= vehiculo.matricula %>" required><br>
  <label>Marca:</label>
  <input type="text" name="marca" value="<%= vehiculo.marca %>" required><br>
  <label>Modelo:</label>
  <input type="text" name="modelo" value="<%= vehiculo.modelo %>" required><br>
  <label>Año de Matriculación:</label>
  <input type="number" name="anio_matriculacion" value="<%= vehiculo.anio_matriculacion %>" required><br>
  <label>Número de Plazas:</label>
  <input type="number" name="numero_plazas" value="<%= vehiculo.numero_plazas %>" required><br>
  <label>Autonomía (km):</label>
  <input type="number" name="autonomia_km" value="<%= vehiculo.autonomia_km %>" required><br>
  <label>Color:</label>
  <input type="text" name="color" value="<%= vehiculo.color %>" required><br>
   <label>Imagen (URL):</label>
<input type="text" name="imagen" value="<%= vehiculo.imagen || '' %>"><br>
  <label>Estado:</label>
  <input type="text" name="estado" value="<%= vehiculo.estado %>" required><br>
  <label>ID del Concesionario:</label>
  <input type="number" name="id_concesionario" value="<%= vehiculo.id_concesionario %>" required><
 
<br>
  <button type="submit">Actualizar</button>
</form>
