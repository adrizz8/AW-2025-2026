<!-- Overlay de carga -->
<div class="spinner-overlay" id="spinner">
  <div class="spinner-border spinner-border-custom" role="status">
    <span class="visually-hidden">Cargando...</span>
  </div>
</div>

<section class="formulario">
  <div class="header-layout" style="margin-bottom: 16px; justify-content: space-between; align-items: center;">
    <h1 class="titulo-seccion">Reservas</h1>
    <button type="button" class="cta" id="btn-nueva-reserva" data-bs-toggle="modal"
            data-bs-target="#modalNuevaReserva">
      Nueva reserva
    </button>
  </div>

  <table class="tabla-vehiculos">
    <thead>
      <tr>
        <th>ID de la reserva</th>
        <th>ID del vehículo</th>
        <th>DNI del cliente</th>
        <th>Nombre del cliente</th>
        <th>Fecha de inicio</th>
        <th>Fecha de fin</th>
        <th>Estado</th>
      </tr>
    </thead>
    <tbody id="tbody">
      <tr>
        <td colspan="7">Cargando...</td>
      </tr>
    </tbody>
  </table>
</section>

<!-- Modal Nueva Reserva -->
<div class="modal fade" id="modalNuevaReserva" tabindex="-1" aria-labelledby="modalNuevaReservaLabel"
     aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content formulario">
      <div class="modal-header" style="border-bottom:none; padding-bottom:0;">
        <h2 class="modal-title" id="modalNuevaReservaLabel">Añadir reserva</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>

      <div class="modal-body" style="padding-top:10px;">
        <form id="form-nueva-reserva" method="POST" action="/reservas/nueva">

          <div class="campo-form">
            <label for="id_vehiculo">Vehículo *</label>
            <select id="id_vehiculo" name="id_vehiculo" required>
              <option value="" disabled selected>Seleccione un vehículo...</option>
              <% if (typeof vehiculos !== 'undefined' && vehiculos.length > 0) { %>
                <% vehiculos.forEach(v => { %>
                  <option value="<%= v.id_vehiculo %>">
                    <%= v.marca %> <%= v.modelo %> - <%= v.matricula %>
                  </option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div class="campo-grupo">
            <div class="campo-form">
              <label for="dni_cliente">DNI del cliente *</label>
              <input type="text" id="dni_cliente" name="dni_cliente" required>
            </div>

            <div class="campo-form">
              <label for="nombre">Nombre *</label>
              <input type="text" id="nombre" name="nombre" required>
            </div>
          </div>

          <div class="campo-grupo">
            <div class="campo-form">
              <label for="fecha_inicio">Fecha y hora de inicio *</label>
              <input type="text" id="fecha_inicio" name="fecha_inicio" required>
            </div>

            <div class="campo-form">
              <label for="fecha_fin">Fecha y hora de fin *</label>
              <input type="text" id="fecha_fin" name="fecha_fin" required>
            </div>
          </div>

          <button type="submit" class="cta" style="width:100%; margin-top:14px;">
            Crear reserva
          </button>
        </form>
      </div>

      <div class="modal-footer" style="border-top:none; justify-content:flex-end;">
        <button type="button" class="volver" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const pickerInicio = flatpickr("#fecha_inicio", {
      enableTime: true,
      time_24hr: true,
      minDate: "today",
      dateFormat: "d/m/Y H:i"
    });

    const pickerFin = flatpickr("#fecha_fin", {
      enableTime: true,
      time_24hr: true,
      minDate: "today",
      dateFormat: "d/m/Y H:i"
    });

    document.getElementById("fecha_inicio").addEventListener("change", function () {
      pickerFin.set("minDate", this.value);
    });
  });
</script>

<script src="/js/procesar_reserva.js"></script>
<script src="/js/cargar_reservas.js"></script>
