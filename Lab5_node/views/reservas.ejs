<!-- Overlay de carga -->
<div class="spinner-overlay" id="spinner">
  <div class="spinner-border spinner-border-custom text-light" role="status">
    <span class="visually-hidden">Cargando...</span>
  </div>
</div>

<div class="container-fluid">
  <div class="header-container d-flex justify-content-between align-items-center my-3">
    <h1>Reservas</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevaReserva">
      ➕ Nueva Reserva
    </button>
  </div>

  <!-- Filtro por tipo de vehículo -->
  <!-- <div class="mb-3">
    <label for="filtroTipo" class="form-label">Filtrar por tipo de vehículo:</label>
    <select class="form-select" id="filtroTipo" style="max-width: 300px;">
      <option value="">Todos los vehículos</option>
      <option value="coche">Coche</option>
      <option value="moto">Moto</option>
      <option value="camion">Camión</option>
      <option value="autobus">Autobús</option>
      <option value="furgoneta">Furgoneta</option>
      <option value="camioneta">Camioneta</option>
      <option value="bicicleta">Bicicleta</option>
      <option value="scooter">Scooter</option>
    </select>
  </div> -->

  <table class="table table-striped">
    <thead>
      <tr>
        <th>ID de la reserva</th>
        <th>ID del usuario</th>
        <th>ID del vehículo</th>
        <th>Fecha de inicio</th>
        <th>Fecha de fin</th>
        <th>Estado</th>
        <th>Kilometros recorridos</th>
        <th>Incidencias reportadas</th>
      </tr>
    </thead>
    <tbody id="tbody">
      <tr><td colspan="10">Cargando...</td></tr>
    </tbody>
  </table>
</div>

<!-- Modal para Nueva Reserva -->
<!-- Modal Nueva Reserva -->
<div class="modal fade" id="modalNuevaReserva" tabindex="-1" aria-labelledby="modalNuevaReservaLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalNuevaReservaLabel">Añadir Reserva</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="form-nueva-reserva" method="POST" action="/reservas/nueva">
          
          <!-- Selector de Vehículo -->
          <div class="mb-3">
            <label for="vehiculo" class="form-label">Vehículo *</label>
            <select class="form-select" id="vehiculo" name="vehiculo_id" required>
              <option value="" selected disabled>Seleccione un vehículo...</option>
              <!-- Opciones dinámicas desde la base de datos -->
              <% if (typeof vehiculos !== 'undefined' && vehiculos.length > 0) { %>
                <% vehiculos.forEach(vehiculo => { %>
                  <option value="<%= vehiculo.id %>">
                    <%= vehiculo.marca %> <%= vehiculo.modelo %> - <%= vehiculo.matricula %>
                  </option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <div class="mb-3">
            <label for="idCliente" class="form-label">ID del cliente *</label>
            <input type="text" class="form-control" id="idCliente" name="idCliente" required>
          </div>

          <!-- Fecha de Inicio -->
          <div class="mb-3">
            <label for="fecha_inicio" class="form-label">Fecha y Hora de Inicio *</label>
            <div class="input-group" id="datetimepicker-inicio" data-td-target-input="nearest" data-td-target-toggle="nearest">
              <input type="text" class="form-control" id="fecha_inicio" name="fecha_inicio" 
                     data-td-target="#datetimepicker-inicio" required />
              <span class="input-group-text" data-td-target="#datetimepicker-inicio" data-td-toggle="datetimepicker">
                <i class="bi bi-calendar-event"></i>
              </span>
            </div>
          </div>

          <!-- Fecha de Fin -->
          <div class="mb-3">
            <label for="fecha_fin" class="form-label">Fecha y Hora de Fin *</label>
            <div class="input-group" id="datetimepicker-fin" data-td-target-input="nearest" data-td-target-toggle="nearest">
              <input type="text" class="form-control" id="fecha_fin" name="fecha_fin" 
                     data-td-target="#datetimepicker-fin" required />
              <span class="input-group-text" data-td-target="#datetimepicker-fin" data-td-toggle="datetimepicker">
                <i class="bi bi-calendar-event"></i>
              </span>
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100" id="btn-agregar-reserva">
            <i class="bi bi-check-circle me-2"></i>Crear Reserva
          </button>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- Scripts necesarios (agregar al final de tu layout principal) -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Inicializar datepicker de inicio
  const pickerInicio = new tempusDominus.TempusDominus(document.getElementById('datetimepicker-inicio'), {
    display: {
      components: {
        calendar: true,
        date: true,
        month: true,
        year: true,
        decades: true,
        clock: true,
        hours: true,
        minutes: true,
        seconds: false
      }
    },
    localization: {
      locale: 'es',
      format: 'dd/MM/yyyy HH:mm',
      hourCycle: 'h23'
    },
    restrictions: {
      minDate: new Date()
    }
  });

  // Inicializar datepicker de fin
  const pickerFin = new tempusDominus.TempusDominus(document.getElementById('datetimepicker-fin'), {
    display: {
      components: {
        calendar: true,
        date: true,
        month: true,
        year: true,
        decades: true,
        clock: true,
        hours: true,
        minutes: true,
        seconds: false
      }
    },
    localization: {
      locale: 'es',
      format: 'dd/MM/yyyy HH:mm',
      hourCycle: 'h23'
    },
    restrictions: {
      minDate: new Date()
    }
  });

  // Sincronizar: la fecha fin debe ser posterior a la fecha inicio
  pickerInicio.subscribe('change.td', (e) => {
    if (e.date) {
      pickerFin.updateOptions({
        restrictions: {
          minDate: e.date
        }
      });
    }
  });
});
</script>

<!-- scripts -->
<script src="/js/cargar_reservas.js"></script>
<script src="/js/procesar_reserva.js"></script>
