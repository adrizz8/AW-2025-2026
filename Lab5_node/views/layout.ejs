<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof titulo !=='undefined' ? titulo : 'Sistema de Reservas' %>
  </title>

  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="/css/mapa.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
  <link rel="stylesheet" href="/css/vehiculos.css">
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/reservas.css">
</head>

<body class="layout">

  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

  <% if (typeof mostrarHeader !=='undefined' ? mostrarHeader : true) { %>
    <header class="header-layout">

      <div class="header-left">
        <div class="logo-container">
          <a href="/">
            <img src="/images/logo.png" alt="Logo de la empresa" class="logo-img">
          </a>
        </div>

        <% if (usuario && usuario.rol==="admin" ) { %>
          <div class="cta-container gestionar">
            <a href="/vehiculos" class="cta-layout">Gestionar Vehículos</a>
            <a href="/concesionarios" class="cta-layout">Gestionar Concesionarios</a>
          </div>
          <% } %>
      </div>

      <div class="header-right">
        <% if (usuario) { %>
          <div class="cta-container usuario">
            👋 Hola, <strong>
              <%= usuario.nombre %>
            </strong>
            <a href="/logout" class="cta-layout">Cerrar sesión</a>

            <% if (usuario.rol==="admin" ) { %>
              <a href="/registro" class="cta-layout">Registrar</a>
              <% } %>
          </div>
          <% } else { %>
            <div class="cta-container usuario">
              <a href="/login" class="cta-layout">Iniciar sesión</a>
            </div>
            <% } %>
              <div class="dropdown accesibilidad-menu">
                <button class="btn btn-secondary dropdown-toggle" type="button" id="menuAccesibilidad"
                  data-bs-toggle="dropdown" aria-expanded="false">
                  Accesibilidad
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menuAccesibilidad">
                  <li>
                    <button class="dropdown-item" type="button" id="btn-contraste">
                      Cambiar contraste
                    </button>
                  </li>
                  <li>
                    <button class="dropdown-item" type="button" id="btn-texto-grande" aria-pressed="false">
                      Cambiar tamaño
                    </button>
                  </li>
                </ul>
              </div>
      </div>
    </header>

    <% } %>

      <main class="main-layout">
        <%- body %>
      </main>

      <% if (typeof mostrarFooter !=='undefined' ? mostrarFooter : true) { %>
        <footer class="footer-layout">

          <div class="footer-item centro">
            &copy; 2025 Sistema de Reservas
          </div>
        </footer>
        <% } %>
          <script src="/js/modo.js"></script>
          <script src="/js/bootstrap.bundle.min.js"></script>
</body>

</html>