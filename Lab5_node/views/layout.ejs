<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof titulo !== 'undefined' ? titulo : 'Sistema de Reservas' %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="layout">
  <header class="header-layout">
    <div class="logo-container">
      <a href="/">
        <img src="/images/logo.png" alt="Logo de la empresa" class="logo-img">
      </a>
    </div>
    <div class="cta-container">
      <a href="/login" class="cta-layout">Iniciar sesión</a>
      <a href="/registro" class="cta-layout">Registrarse</a>
    </div>
  </header>

  <main class="main-layout">
    <%- body %> <!-- Aquí se insertará el contenido de cada vista -->
  </main>

  <footer>
    <p>&copy; 2025 Sistema de Reservas</p>
  </footer>
</body>
</html>
