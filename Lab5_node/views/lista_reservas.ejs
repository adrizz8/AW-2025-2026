<main class="card">
  <h1>📋 Lista de Reservas</h1>

  <p>Actualmente hay <strong>
      <%= total %>
    </strong> reservas registradas.</p>

  <section id="lista-reservas" summary="Listado de reservas. Se muestran en orden el nombre, email, teléfono, vehículo, fecha y hora de inicio, fecha y hora de fin, y fecha de la reserva.">
    <table>
      <thead>
        <tr>
          <th scope="col">Nombre</th>
          <th scope="col">Email</th>
          <th scope="col">Telefono</th>
          <th scope="col">Vehiculo</th>
          <th scope="col">Fecha de inicio</th>
          <th scope="col">Hora de inicio</th>
          <th scope="col">Fecha de fin</th>
          <th scope="col">Hora de fin</th>
          <th scope="col">Fecha de la reserva</th>
        </tr>
      </thead>
      <tbody>
        <% reservas.forEach(reserva=> { %>
          <tr>
            <td>
              <%= reserva.nombre %>
            </td>
            <td>
              <%= reserva.email %>
            </td>
            <td>
              <%= reserva.telefono %>
            </td>
            <td>
              <%= reserva.tipo_vehiculo %>
            </td>
            <td>
              <%= reserva.fecha_inicio %>
            </td>
            <td>
              <%= reserva.hora_inicio %>
            </td>
            <td>
              <%= reserva.fecha_fin %>
            </td>
            <td>
              <%= reserva.hora_fin %>
            </td>
            <td>
              <%= reserva.fecha_reserva %>
            </td>
          </tr>
          <% }) %>
      </tbody>
    </table>
  </section>

  <a href="/" class="volver">← Volver al inicio</a>
  <a href="/reservar" class="cta">+ Crear nueva reserva</a>

  <div class="meta">Página generada dinámicamente desde el servidor ✨</div>
</main>