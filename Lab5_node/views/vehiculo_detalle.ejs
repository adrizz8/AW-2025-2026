<h1>Detalle del Vehículo</h1>
<p class="meta">ID: <strong>
          <%= vehiculo.id_vehiculo %>
     </strong></p>

<div style="display:flex; flex-wrap:wrap; gap:24px; align-items:flex-start;">
     <!-- Tabla de datos -->
     <div style="flex:1 1 260px; min-width:260px;">
          <table class="tabla-vehiculos" summary="Detalle del vehículo. Se muestran en orden la matrícula, marca, modelo, año de matriculación, número de plazas, autonomía en km, color, estado e ID del concesionario.">
               <tbody>
                    <tr>
                         <th scope="col">Matrícula</th>
                         <td>
                              <%= vehiculo.matricula %>
                         </td>
                    </tr>
                    <tr>
                         <th scope="col">Marca</th>
                         <td>
                              <%= vehiculo.marca %>
                         </td>
                    </tr>
                    <tr>
                         <th scope="col">Modelo</th>
                         <td>
                              <%= vehiculo.modelo %>
                         </td>
                    </tr>
                    <tr>
                         <th scope="col">Año matriculación</th>
                         <td>
                              <%= vehiculo.anio_matriculacion %>
                         </td>
                    </tr>
                    <tr>
                         <th scope="col">Nº plazas</th>
                         <td>
                              <%= vehiculo.numero_plazas %>
                         </td>
                    </tr>
                    <tr>
                         <th scope="col">Autonomía (km)</th>
                         <td>
                              <%= vehiculo.autonomia_km %>
                         </td>
                    </tr>
                    <tr>
                         <th scope="col">Color</th>
                         <td>
                              <%= vehiculo.color %>
                         </td>
                    </tr>
                    <tr>
                         <th scope="col">Estado</th>
                         <td>
                              <%= vehiculo.estado %>
                         </td>
                    </tr>
                    <tr>
                         <th scope="col">ID concesionario</th>
                         <td>
                              <%= vehiculo.id_concesionario %>
                         </td>
                    </tr>
               </tbody>
          </table>
     </div>

     <!-- Imagen -->
     <div style="flex:0 0 260px; text-align:center;">
          <% if (vehiculo.imagen) { %>
               <img src="<%= vehiculo.imagen %>" alt="Imagen del vehículo"
                    style="max-width:260px; width:100%; border-radius:14px; box-shadow:0 4px 10px rgba(0,0,0,0.15);">
               <% } else { %>
                    <p class="meta">Sin imagen disponible</p>
                    <% } %>
     </div>
</div>

<div class="nav-acciones" style="margin-top: 24px;">
     <a href="/vehiculos" class="cta">← Volver al listado</a>

     <a href="/vehiculos/<%= vehiculo.id_vehiculo %>/editar" class="cta">
          Editar vehículo
     </a>

     <form action="/vehiculos/<%= vehiculo.id_vehiculo %>/eliminar" method="POST" style="display:inline;">
          <button type="submit" class="eliminar"
               onclick="return confirm('¿Seguro que quieres eliminar este vehículo?');">
               Eliminar
          </button>
     </form>
</div>