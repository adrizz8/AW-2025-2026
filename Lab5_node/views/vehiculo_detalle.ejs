<h1>Detalle Vehículo</h1>
<p><strong>ID:</strong> <%= vehiculo.id_vehiculo %></p>
<p><strong>Matrícula:</strong> <%= vehiculo.matricula %></p>
<p><strong>Marca:</strong> <%= vehiculo.marca %></p>
<p><strong>Modelo:</strong> <%= vehiculo.modelo %></p>
<p><strong>Año de Matriculación:</strong> <%= vehiculo.anio_matriculacion %></p>
<p><strong>Número de Plazas:</strong> <%= vehiculo.numero_plazas %></p>
<p><strong>Autonomía (km):</strong> <%= vehiculo.autonomia_km %></p>
<p><strong>Color:</strong> <%= vehiculo.color %></p>
<img src="<%= vehiculo.imagen %>" alt="Imagen del vehículo"
     style="max-width: 300px; border-radius:10px; margin-bottom:20px;">
<p><strong>Estado:</strong> <%= vehiculo.estado %></p>
<p><strong>ID del Concesionario:</strong> <%= vehiculo.id_concesionario %></p>
<a href="/vehiculos">Volver a la lista</a>
