<h1>Lista de Vehículos</h1>

<form id="buscador" style="margin-bottom: 20px;">
  <input type="text" id="q" placeholder="Buscar por marca o modelo...">
  <button type="submit">Buscar</button>
</form>

<% if (admin) { %>
  <a href="/vehiculos/nuevo" class="btn btn-primary">Añadir Vehículo</a>
<% } %>

<table border="1">
  <thead>
    <tr>
      <th>ID</th>
      <th>Marca</th>
      <th>Modelo</th>
      <th>Tipo</th>
      <th>Precio/Hora</th>
      <th>Acciones</th>
      <th>Imagen</th>
    </tr>
  </thead>
  <tbody id="vehiculos-body">
    <tr><td colspan="7">Cargando...</td></tr>
  </tbody>
</table>

<script>
  // Pasamos variable del servidor a JS
  const esAdmin = <%= admin ? 'true' : 'false' %>;

  async function cargarVehiculos(query = '') {
    const tbody = document.getElementById('vehiculos-body');
    tbody.innerHTML = '<tr><td colspan="7">Cargando...</td></tr>';

    try {
      const res = await fetch('/api/vehiculos?q=' + encodeURIComponent(query));
      const vehiculos = await res.json();

      if (!vehiculos.length) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;">No se encontraron vehículos.</td></tr>';
        return;
      }

      tbody.innerHTML = '';
      vehiculos.forEach(v => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>${v.id}</td>
          <td>${v.marca}</td>
          <td>${v.modelo}</td>
          <td>${v.tipo}</td>
          <td>${v.precioHora}€</td>
          <td>
            <a href="/vehiculos/${v.id}">Ver</a>
            ${esAdmin ? ` | <a href="/vehiculos/${v.id}/editar">Editar</a>` : ''}
          </td>
          <td>
            <img src="${v.imagen}" alt="Imagen ${v.marca}" style="width:120px;border-radius:8px;">
          </td>
        `;
        tbody.appendChild(tr);
      });
    } catch (err) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:red;">Error cargando vehículos</td></tr>';
      console.error(err);
    }
  }

  // Cargar al iniciar
  cargarVehiculos();

  // Buscador
  document.getElementById('buscador').addEventListener('submit', e => {
    e.preventDefault();
    const q = document.getElementById('q').value;
    cargarVehiculos(q);
  });
</script>
