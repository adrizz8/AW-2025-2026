<h1>Lista de Vehículos</h1>

<form method="GET" action="/vehiculos" class="filtros">
  <div style="flex:1; min-width:250px;">
    <label for="q">Buscar por marca o modelo:</label>
    <input type="text" id="q" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Buscar...">
  </div>

  <div style="display:flex; align-items:flex-end;">
    <button type="submit" class="btn-buscar">Buscar</button>
  </div>
</form>

<% if (admin) { %>
  <a href="/vehiculos/nuevo" class="btn-nuevo">Añadir Vehículo</a>
<% } %>
    <table class="tabla-vehiculos">
      <thead>
        <tr>
          <th>ID</th>
          <th>Matrícula</th>
          <th>Marca</th>
          <th>Modelo</th>
          <th>Año</th>
          <th>Plazas</th>
          <th>Autonomía</th>
          <th>Color</th>
          <th>Imagen</th>
          <th>Estado</th>
          <th>Concesionario</th>
          <th>Acciones</th>
        </tr>
      </thead>

      <tbody>
        <% if (results.length===0) { %>
          <tr>
            <td colspan="<%= admin ? 12 : 11 %>">No se encontraron vehículos</td>
          </tr>
          <% } else { %>
            <% results.forEach(v=> { %>
              <tr>
                <td>
                  <%= v.id_vehiculo %>
                </td>
                <td>
                  <%= v.matricula %>
                </td>
                <td>
                  <%= v.marca %>
                </td>
                <td>
                  <%= v.modelo %>
                </td>
                <td>
                  <%= v.anio_matriculacion %>
                </td>
                <td>
                  <%= v.numero_plazas %>
                </td>
                <td>
                  <%= v.autonomia_km %>
                </td>
                <td>
                  <%= v.color %>
                </td>

                <td>
                  <img src="<%= v.imagen %>" alt="Imagen <%= v.marca %> <%= v.modelo %>">
                </td>

                <td class="<%= v.estado === 'disponible' ? 'estado-disponible' : 'estado-no' %>">
                  <%= v.estado %>
                </td>

                <td>
                  <%= v.id_concesionario %>
                </td>


                <td class="acciones">
                  <a href="/vehiculos/<%= v.id_vehiculo %>" class="ver">Ver</a>
                  <a href="/vehiculos/<%= v.id_vehiculo %>/editar" class="editar">Editar</a>
                  <form action="/vehiculos/<%= v.id_vehiculo %>/eliminar" method="POST" style="display:inline;">
                    <button type="submit" class="eliminar" onclick="return confirm('¿Eliminar vehículo?')">
                      Eliminar
                    </button>
                  </form>
                </td>

              </tr>
              <% }) %>
                <% } %>
      </tbody>
    </table>