<h1>Lista de Vehículos</h1>
<% if (usuario) { %>
  <a href="/vehiculos/nuevo" class="btn btn-primary">Añadir Vehículo</a>
  <% } %>
    <table border="1">
      <thead>
        <tr>
          <th>ID</th>
          <th>Marca</th>
          <th>Modelo</th>
          <th>Tipo</th>
          <th>Precio/Hora</th>
          <th>Acciones</th>
          <th>Imagen</th>
        </tr>
      </thead>
      <tbody>
        <% vehiculos.forEach(v=> { %>
          <tr>
            <td>
              <%= v.id %>
            </td>
            <td>
              <%= v.marca %>
            </td>
            <td>
              <%= v.modelo %>
            </td>
            <td>
              <%= v.tipo %>
            </td>
            <td>
              <%= v.precioHora %>€
            </td>
            <td>
              <a href="/vehiculos/<%= v.id %>">Ver</a> |
              <% if (usuario) { %>
                <a href="/vehiculos/<%= v.id %>/editar" class="btn btn-warning">Editar</a>
                <form action="/vehiculos/<%= v.id %>/eliminar" method="POST">
                  <button class="btn btn-danger">Eliminar</button>
                </form>
                <% } %>
            </td>
            <td>
              <img src="<%= v.imagen %>" alt="Imagen <%= v.marca %>" style="width: 120px; border-radius:8px;">
            </td>
          </tr>
          <% }) %>
      </tbody>
    </table>