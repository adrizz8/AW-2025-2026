<h1>Lista de Vehículos</h1>

<!-- Formulario de filtros -->
<form method="GET" action="/vehiculos" style="display:flex; gap:15px; flex-wrap:wrap; margin-bottom:20px;">
  <div style="flex:1; min-width:200px;">
    <label for="q">Buscar por marca o modelo:</label>
    <input type="text" id="q" name="q" placeholder="Buscar..." value="<%= typeof q !== 'undefined' ? q : '' %>" style="width:100%; padding:8px;">
  </div>
  <div style="display:flex; align-items:flex-end;">
    <button type="submit" style="padding:8px 20px;">Buscar</button>
  </div>
</form>

<% if (admin) { %>
  <a href="/vehiculos/nuevo" class="btn btn-primary" style="margin-bottom:15px; display:inline-block;">Añadir Vehículo</a>
<% } %>

<table border="1" style="width:100%; border-collapse:collapse;">
  <thead>
    <tr>
      <th>ID</th>
      <th>Matricula</th>
      <th>Marca</th>
      <th>Modelo</th>
      <th>Año de matriculación</th>
      <th>Número de plazas</th>
      <th>Autonomía (km)</th>
      <th>Color</th>
      <th>Imagen</th>
      <th>Estado</th>
      <th>Concesionario</th>
      <% if (admin) { %><th>Acciones</th><% } %>
    </tr>
  </thead>
  <tbody>
    <% if (results.length === 0) { %>
      <tr>
        <td colspan="<%= admin ? 12 : 11 %>" style="text-align:center;">No se encontraron vehículos</td>
      </tr>
    <% } else { %>
      <% results.forEach(v => { %>
        <tr>
          <td><%= v.id_vehiculo %></td>
          <td><%= v.matricula %></td>
          <td><%= v.marca %></td>
          <td><%= v.modelo %></td>
          <td><%= v.anio_matriculacion %></td>
          <td><%= v.numero_plazas %></td>
          <td><%= v.autonomia_km %></td>
          <td><%= v.color %></td>
          <td><img src="<%= v.imagen %>" style="width:100px; border-radius:6px;"></td>
          <td><%= v.estado %></td>
          <td><%= v.id_concesionario %></td>
          <% if (admin) { %>
            <td>
              <a href="/vehiculos/<%= v.id_vehiculo %>">Ver</a> |
              <a href="/vehiculos/<%= v.id_vehiculo %>/editar">Editar</a> |
              <form action="/vehiculos/<%= v.id_vehiculo %>/eliminar" method="POST" style="display:inline;">
                <button type="submit" onclick="return confirm('¿Eliminar vehículo?')">Eliminar</button>
              </form>
            </td>
          <% } %>
        </tr>
      <% }) %>
    <% } %>
  </tbody>
</table>
