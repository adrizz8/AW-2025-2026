<h1>Lista de Vehículos</h1>
<form method="GET" action="/vehiculos" style="margin-bottom: 20px;">
  <input
    type="text"
    name="q"
    placeholder="Buscar por marca o modelo..."
    value="<%= q %>"
  >
  <button type="submit">Buscar</button>
</form>

<% if (admin) { %>
  <a href="/vehiculos/nuevo" class="btn btn-primary">Añadir Vehículo</a>
  <% } %>
    <table border="1">
      <thead>
        <tr>
          <th>ID</th>
          <th>Marca</th>
          <th>Modelo</th>
          <th>Tipo</th>
          <th>Precio/Hora</th>
          <th>Acciones</th>
          <th>Imagen</th>
        </tr>
      </thead>
      <tbody>
        <% vehiculos.forEach(v=> { %>
          <tr>
            <td>
              <%= v.id %>
            </td>
            <td>
              <%= v.marca %>
            </td>
            <td>
              <%= v.modelo %>
            </td>
            <td>
              <%= v.tipo %>
            </td>
            <td>
              <%= v.precioHora %>€
            </td>
            <td>
              <a href="/vehiculos/<%= v.id %>">Ver</a> |
              <% if (admin) { %>
                <a href="/vehiculos/<%= v.id %>/editar" class="btn btn-warning">Editar</a>
                <form action="/vehiculos/<%= v.id %>/eliminar" method="POST">
                  <button class="btn btn-danger">Eliminar</button>
                </form>
                <% } %>
            </td>
            <td>
              <img src="<%= v.imagen %>" alt="Imagen <%= v.marca %>" style="width: 120px; border-radius:8px;">
            </td>
          </tr>
          <% }) %>
      </tbody>
      <% if (vehiculos.length === 0) { %>
  <tr>
    <td colspan="7" style="text-align: center; font-weight: bold;">
      No se encontraron vehículos con "<%= q %>"
    </td>
  </tr>
<% } %>

    </table>